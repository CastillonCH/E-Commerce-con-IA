# Azure Blob Storage para las fotos de producto (coincide con lo que
# next.config.ts espera en AZURE_BLOB_HOSTNAME). Sin esto, el servicio
# guarda las fotos en disco local — solo para desarrollo.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=productos

# URL pública de este servicio (para armar las imagen_url cuando cae al
# fallback de disco local).
PUBLIC_BASE_URL=http://localhost:8000

# Orígenes permitidos por CORS — el frontend Next.js.
CORS_ORIGINS=["http://localhost:3000"]

# Postgres, solo para scripts/eval_cu5_duplicates.py (lee el catálogo y
# escribe en producto_embeddings/duplicados_detectados).
DATABASE_URL=postgresql://usuario:password@localhost:5432/novastore_db

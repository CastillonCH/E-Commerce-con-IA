# Dónde están los modelos entrenados (ver README.md para la estructura
# exacta de carpetas, o GUIA_COLAB.md para cómo copiarlos desde Drive).
# Si no existe o está vacío, el servicio arranca igual en modo "demo".
MODELS_DIR=./models

# Secreto compartido con Next.js (header X-API-Key en cada request a
# /modelos y /clasificar). Debe ser el MISMO valor que AI_API_KEY en el
# .env.local del frontend. Si lo dejas vacío, el servicio no exige
# autenticación (solo para correr en tu máquina, nunca en producción).
AI_API_KEY=

# Peso de la imagen al combinar CU1 (imagen) + CU2 (texto) en una sola
# predicción: P = peso * promedio(modelos de imagen) + (1 - peso) * P_texto.
# Usa el valor que imprime ml/evaluar_fusion.py (elegido en validación).
PESO_FUSION_IMAGEN=0.6

PORT=8000

# Cadena de conexión a PostgreSQL (el esquema "novastore" que crea
# novastore_postgresql.sql). Ejemplo local:
#   postgresql://postgres:postgres@localhost:5432/novastore_db
DATABASE_URL="postgresql://postgres:root@localhost:6363/ecommerce_ia" 

# URL base del backend en FastAPI. Nunca hardcodear esto en el código.
# Solo lo usa hoy la clasificación de imágenes por IA al dar de alta un
# producto (lib/api.ts) — el resto de la app (catálogo, pedidos, usuarios)
# ya habla directo con PostgreSQL vía DATABASE_URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL pública del sitio (sin / al final). Usada para metadataBase,
# sitemap.xml, robots.txt y los enlaces canónicos/Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clave usada para firmar las sesiones (JWT, HS256). Generar con:
#   openssl rand -base64 32
# Debe tener al menos 32 caracteres. Sin esta variable, la app rechaza
# arrancar en vez de usar un secreto por defecto inseguro.
AUTH_SECRET=

# Número de WhatsApp de soporte (formato E.164 sin "+"), usado por el
# widget del asistente virtual para el handoff a un asesor humano.
NEXT_PUBLIC_WHATSAPP_NUMBER=51920549543

# Credenciales OAuth de Google (Google Cloud Console -> APIs & Services ->
# Credentials -> Create OAuth Client ID -> Web application). Registrar
# "<tu-dominio>/api/auth/google/callback" como Authorized redirect URI
# (en desarrollo: http://localhost:3000/api/auth/google/callback).
# Sin estas variables, el botón "Continuar con Google" muestra un error
# controlado en vez de romper — ver app/api/auth/google/route.ts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

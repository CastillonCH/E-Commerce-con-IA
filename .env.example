# Cadena de conexión a PostgreSQL (el esquema "novastore" que crea
# novastore_postgresql.sql). Ejemplo local:
#   postgresql://postgres:postgres@localhost:5432/novastore_db
DATABASE_URL="postgresql://postgres:root@localhost:6363/ecommerce_ia" 

# URL pública del sitio (sin / al final). Usada para metadataBase,
# sitemap.xml, robots.txt, los enlaces canónicos/Open Graph, y para armar
# la URL absoluta de las fotos de producto cuando se guardan en
# public/uploads/ (fallback de desarrollo sin Azure Blob — ver lib/storage.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clave usada para firmar las sesiones (JWT, HS256). Generar con:
#   openssl rand -base64 32
# Debe tener al menos 32 caracteres. Sin esta variable, la app rechaza
# arrancar en vez de usar un secreto por defecto inseguro.
AUTH_SECRET=

# Número de WhatsApp de soporte (formato E.164 sin "+"), usado por el
# widget del asistente virtual para el handoff a un asesor humano.
NEXT_PUBLIC_WHATSAPP_NUMBER=51920549543

# Credenciales OAuth de Google (Google Cloud Console -> APIs & Services ->
# Credentials -> Create OAuth Client ID -> Web application). Registrar
# "<tu-dominio>/api/auth/google/callback" como Authorized redirect URI
# (en desarrollo: http://localhost:3000/api/auth/google/callback).
# Sin estas variables, el botón "Continuar con Google" muestra un error
# controlado en vez de romper — ver app/api/auth/google/route.ts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Módulo de IA (ai-service/, ver su propio README.md) — opcionales: sin
# AI_SERVICE_URL, dar de alta un producto sigue funcionando igual, solo
# que queda en revisión sin categoría sugerida (nunca se bloquea al
# vendedor). AI_API_KEY solo si tu ai-service exige autenticación (deben
# coincidir con el AI_API_KEY de ai-service/.env).
AI_SERVICE_URL=http://localhost:8000
AI_API_KEY=

# "todos" (por defecto): cada producto nuevo pasa por /admin/revision sin
# importar la confianza del modelo. "umbral": publica directo si la
# confianza llega a REVIEW_THRESHOLD (0 a 1) y la categoría sugerida
# pertenece al departamento que eligió el vendedor.
REVIEW_POLICY=todos
REVIEW_THRESHOLD=0.75

# Azure Blob Storage para las fotos de producto en producción. Sin
# AZURE_STORAGE_CONNECTION_STRING, lib/storage.ts guarda en
# public/uploads/ (solo para desarrollo local, fuera de git).
# AZURE_BLOB_HOSTNAME habilita ese dominio en next.config.ts
# (images.remotePatterns y la Content-Security-Policy) — ej.
# "misteancuenta.blob.core.windows.net".
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_HOSTNAME=
